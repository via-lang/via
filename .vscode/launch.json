    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "run",
                    "--bin=via_cli",
                    "--package=via_cli"
                ]
            },
            "args": ["run", "${workspaceFolder}/test/basic.via"]
        },
        {
            "name": "Debug unit tests in executable 'via_cli'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--bin=via_cli",
                    "--package=via_cli"
                ]
            }
        },
        {
            "name": "Debug unit tests in library 'viac'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--package=viac"
                ]
            }
        },
        {
            "name": "Debug unit tests in library 'via_vm'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--package=via_vm"
                ]
            }
        }
    ]
}