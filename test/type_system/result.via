struct Result<T, E> {
  #constructor("implicit")
  static fn some(value: T) {
    return Self { value: value };
  }

  #constructor("implicit")
  static fn error(error: E) {
    return Self { value: error };
  }

  fn has_value() -> bool {
    return self.value.holds::<T>();
  }

  fn unwrap() -> T raise E {
    ifx self.has_value():
      raise<E> refl::type_name<Self>();
    return self.value as T;
  }

  impl<U> From<Self>
  fn to<U impl From<T>>() -> U raise E {
    return self.unwrap() as U;
  }

  impl From<Self>
  fn to<U = bool>() -> bool {
    return self.has_value();
  }

  impl<T, E> Destructure<T?, E?>
  fn destructure() -> struct<T?, E?> {
    ifx self.value.holds::<T>():
      return struct { self.value as T, none };
    return struct { none, self.value as E };
  }

  #private var value: T | E,
}

fn test_result() {
  use MyResult = Result<int, string>;

  var some: MyResult = 10;
  var error: MyResult = "guh";

  var [val0, err0] = try some.unwrap();
  var [val1, err1] = some;
}

test_result();
